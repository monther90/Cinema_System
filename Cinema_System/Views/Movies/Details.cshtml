@model Cinema_System.Models.Movie
@{
    ViewData["Title"] = "Movie Details";
}

<div class="container py-4" style="max-width: 700px;">
    <div class="card bg-dark text-white p-4 border-0 shadow">
        <div class="text-center mb-4">
            <img src="@Model.MainImg" alt="@Model.Name" style="max-height: 300px; object-fit: cover;" class="rounded w-100 mb-3" />
            <h2>@Model.Name</h2>
        </div>

        <p class="text-muted">@Model.Description</p>

        <ul class="list-group list-group-flush bg-transparent mb-4">
            <li class="list-group-item bg-dark text-white border-secondary">
                <strong>Price:</strong> $@Model.Price
            </li>
            <li class="list-group-item bg-dark text-white border-secondary">
                <strong>Date & Time:</strong> @Model.DateTime.ToString("yyyy-MM-dd HH:mm")
            </li>
            <li class="list-group-item bg-dark text-white border-secondary">
                <strong>Category:</strong> @(Model.Category?.Name ?? "N/A")
            </li>
            <li class="list-group-item bg-dark text-white border-secondary">
                <strong>Cinema:</strong> @(Model.Cinema?.Name ?? "N/A")
            </li>
        </ul>

        <div class="d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit Movie</a>
        </div>
    </div>
</div>