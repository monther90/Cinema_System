@model Cinema_System.Models.Movie
@{ ViewData["Title"] = "Add Movie"; }

<div class="container py-4" style="max-width: 700px;">
    <div class="card bg-dark text-white p-4 border-0 shadow">
        <h3 class="mb-3">Add New Movie</h3>
        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label asp-for="Name" class="form-label">Movie Title</label>
                <input asp-for="Name" class="form-control" placeholder="Enter movie title" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter description"></textarea>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Price" class="form-label">Price ($)</label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="MainImg" class="form-label">Main Image URL</label>
                    <input asp-for="MainImg" class="form-control" placeholder="Image link" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="CategoryId" class="form-label">Category</label>
                    <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.CategoryId">
                        <option value="">-- Select Category --</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="CinmaId" class="form-label">Cinema</label>
                    <select asp-for="CinmaId" class="form-control" asp-items="ViewBag.CinmaId">
                        <option value="">-- Select Cinema --</option>
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="DateTime" class="form-label">Date & Time</label>
                <input asp-for="DateTime" type="datetime-local" class="form-control" />
            </div>

            <div class="d-flex justify-content-between mt-3">
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                <button type="submit" class="btn btn-danger px-4">Save Movie</button>
            </div>
        </form>
    </div>
</div>