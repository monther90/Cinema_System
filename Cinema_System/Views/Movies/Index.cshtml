@model IEnumerable<Cinema_System.Models.Movie>
@{
    ViewData["Title"] = "Movies Management";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Movies Management</h2>
        <a asp-action="Create" class="btn btn-danger">Add New Movie</a>
    </div>
    <table class="table table-dark table-striped align-middle">
        <thead>
            <tr>
                <th>Image</th>
                <th>Title</th>
                <th>Price</th>
                <th>Date & Time</th>
                <th>Category</th>
                <th>Cinema</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <img src="@item.MainImg" alt="@item.Name" style="width: 50px; height: 50px; object-fit: cover;" class="rounded" />
                    </td>
                    <td>@item.Name</td>
                    <td>$@item.Price</td>
                    <td>@item.DateTime.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@(item.Category?.Name ?? "N/A")</td>
                    <td>@(item.Cinema?.Name ?? "N/A")</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>