<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cinema_System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            background-color: #eef2f7;
            color: #212529;
        }
        #sidebar {
            background: linear-gradient(180deg, #111827 0%, #1f2937 100%);
            border-right: 1px solid #374151;
            min-height: 100vh;
        }
        #sidebar h4 {
            color: #ffffff;
            font-weight: 700;
            letter-spacing: 1px;
        }
        #sidebar .nav-link {
            background-color: #374151;
            color: #f3f4f6;
            border: 1px solid #4b5563;
            transition: all 0.3s ease;
            font-weight: 500;
        }
        #sidebar .nav-link:hover {
            background-color: #dc2626;
            color: #ffffff;
            border-color: #b91c1c;
            transform: translateX(3px);
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <nav id="sidebar" class="col-md-3 col-lg-2 d-md-block sidebar collapse py-4">
                <div class="position-sticky">
                    <h4 class="text-center mb-4">CINEMA</h4>
                    <ul class="nav flex-column gap-2 px-2">
                        <ul class="nav flex-column gap-2 px-2">
    <li class="nav-item">
        <a class="nav-link rounded p-2 text-decoration-none d-block" href="/Home/Index">
            📊 Dashboard
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link rounded p-2 text-decoration-none d-block" href="/Categories/Index">
            📁 Manage Categories
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link rounded p-2 text-decoration-none d-block" href="/Cinemas/Index">
            🏢 Manage Cinemas
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link rounded p-2 text-decoration-none d-block" href="/Actors/Index">
            🎭 Manage Actors
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link rounded p-2 text-decoration-none d-block" href="/Movies/Index">
            🎬 Manage Movies
        </a>
    </li>
    <li class="nav-item mt-3">
        <a class="nav-link rounded p-2 text-decoration-none d-block bg-secondary text-white" href="/Home/Index">
            🌐 User Website
        </a>
    </li>
</ul>
                </div>
            </nav>

            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>