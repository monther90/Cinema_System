@model IEnumerable<Cinema_System.Models.Movie>

@{
    ViewData["Title"] = "Home Page";
}

<div class="container my-4">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">Welcome to Cinema System</h1>
        <p class="text-muted">Explore our latest movies and book your seat now!</p>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var movie in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                  
                    <img src="@(!string.IsNullOrEmpty(movie.MainImg) ? movie.MainImg : "/images/default.jpg")" class="card-img-top" alt="@movie.Name" style="height: 300px; object-fit: cover;">

                    <div class="card-body">
                        <h5 class="card-title fw-bold">@movie.Name</h5>
                        <p class="card-text text-muted">@movie.Description.Substring(0, Math.Min(movie.Description.Length, 80))...</p>

                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-primary">@movie.Category?.Name</span>
                            <span class="text-success fw-bold">@movie.Price.ToString("C")</span>
                        </div>

                        <p class="card-text"><small class="text-muted">Cinema: @movie.Cinema?.Name</small></p>
                    </div>

                    <div class="card-footer bg-white border-top-0">
                        <a asp-action="Details" asp-route-id="@movie.Id" class="btn btn-outline-dark w-100">View Details</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>