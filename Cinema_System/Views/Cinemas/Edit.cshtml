@model Cinema_System.Models.Cinema
@{ ViewData["Title"] = "Edit Cinema"; }

<div class="container py-4" style="max-width: 600px;">
    <div class="card bg-dark text-white p-4 border-0 shadow">
        <h3 class="mb-3">Edit Cinema</h3>
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            
            <div class="mb-3">
                <label asp-for="Name" class="form-label">Cinema Name</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Address" class="form-label">Address</label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Img" class="form-label">Image URL</label>
                <input asp-for="Img" class="form-control" />
            </div>

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                <button type="submit" class="btn btn-danger px-4">Update</button>
            </div>
        </form>
    </div>
</div>