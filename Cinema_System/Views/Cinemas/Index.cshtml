@model IEnumerable<Cinema_System.Models.Cinema>
@{ ViewData["Title"] = "Cinemas Management"; }

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Cinemas Management</h2>
        <a asp-action="Create" class="btn btn-danger">Add New Cinema</a>
    </div>
    <table class="table table-dark table-striped align-middle">
        <thead>
            <tr>
                <th>Image</th>
                <th>Name</th>
                <th>Address</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td>
                        <img src="@item.Img" alt="@item.Name" style="width: 50px; height: 50px; object-fit: cover;" class="rounded" />
                    </td>
                    <td>@item.Name</td>
                    <td>@item.Address</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>